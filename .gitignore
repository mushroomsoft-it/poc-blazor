###################################
###       SOLUTION LEVEL       ###
###################################
.DS_Store
Thumbs.db
*.log
logs/
*.tmp
tmp/

###################################
###          DOTNET            ###
###################################
# Build
bin/
obj/
artifacts/

# Evitar ignorar DLL globalmente (importante para Blazor)
# *.dll  <-- Eliminado

# DLL generadas dentro de compilación
bin/**/*.dll
obj/**/*.dll

# Razor
*.razor.g.cs
*.razor.rz.scp.css

# NuGet
*.nupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json

###################################
###           BLAZOR           ###
###################################
# Archivos de desarrollo
*.map

# Publicaciones (publish / build)
publish/
build/
out/

# Node / JS tools (si usas Tailwind, Vite, etc.)
src/Frontend/node_modules/
src/Frontend/dist/
src/Frontend/build/

# Blazor wwwroot
src/Frontend/wwwroot/*.map

###################################
###         API SERVICE        ###
###################################
src/ApiService/bin/
src/ApiService/obj/
src/ApiService/wwwroot/*.map

###################################
###          DOCKER            ###
###################################
docker-data/
volumes/
*.tar
docker-compose.override.yml

# Nginx runtime
nginx/logs/
nginx/cache/

###################################
###         CERTIFICADOS       ###
###################################
certs/
*.crt
*.key
*.pem
*.pfx

###################################
###      ENV files (secret)    ###
###################################
*.env
.env.*
!.env.example
